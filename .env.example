# --- LLM (free local Ollama with qwen2.5:3b) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_SEC=120
# OLLAMA_TEMPERATURE=0.1

# --- Auth ---
# CHANGE THIS to a long random string in production.
JWT_SECRET=dev-secret-change-me-please-use-32-random-bytes
JWT_TTL_HOURS=8

# --- Qdrant (leave QDRANT_URL empty for embedded local disk) ---
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=sap_docs

# --- Hybrid search + HNSW (Hierarchical Navigable Small World) ---
SEARCH_MODE=hybrid
HNSW_M=16
HNSW_EF_CONSTRUCT=128
HNSW_EF_SEARCH=64
HYBRID_PREFETCH_K=20
TOP_K=5

# --- Context window (qwen2.5:3b is 32k) ---
LLM_CONTEXT_WINDOW=32768
MAX_CONTEXT_TOKENS=6000
GENERATION_RESERVE_TOKENS=1024

# --- Optional Gemini fallback (only used if LLM_PROVIDER=gemini) ---
# GOOGLE_API_KEY=
# GEMINI_MODEL_NAME=gemini-2.5-flash
